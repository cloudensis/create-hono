{
	"name": "@cloudensis/create-hono",
	"version": "0.0.0",
	"description": "Create a Hono application for cloudensis.",
	"type": "module",
	"bin": {
		"create-hono": "index.js"
	},
	"scripts": {
		"test": "node --test \"test/*.test.*\"",
		"lint": "biome check",
		"format": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8"
	},
	"files": [
		"index.js",
		"template",
		"!template/node_modules",
		"!template/package-lock.json",
		"!template/.cloudflare",
		"!template/.wrangler"
	],
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudensis/create-hono.git"
	},
	"publishConfig": {
		"access": "public"
	}
}
